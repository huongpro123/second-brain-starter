#!/usr/bin/env sh
# Pre-commit hook: chan lot secret/API key va kiem tra link vault neu sua wiki/index.

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. Quet mau secret pho bien trong cac file text da stage
for f in $staged; do
    [ -f "$f" ] || continue
    case "$f" in
        *.png|*.jpg|*.jpeg|*.docx|*.pdf|*.zip) continue ;;
    esac
    if grep -qE "(sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY)" "$f"; then
        echo "[BLOCKED] Phat hien dau hieu API key / private key trong: $f"
        echo "Hay go bo bi mat truoc khi commit."
        exit 1
    fi
done

# 2. Neu sua note trong wiki/ hoac index.md thi chay health-check neu co PowerShell
if echo "$staged" | grep -qE "^(wiki/|index\.md$)"; then
    if command -v pwsh >/dev/null 2>&1; then
        pwsh -NoProfile -File tools/health-check.ps1 >/dev/null || exit 1
    elif command -v powershell.exe >/dev/null 2>&1; then
        powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/health-check.ps1 >/dev/null || exit 1
    fi
fi

exit 0
